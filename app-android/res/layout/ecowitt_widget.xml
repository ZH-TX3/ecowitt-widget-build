                    android:layout_height="9dp"
                    android:layout_marginEnd="3dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/ecowitt_widget_label_1_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="10sp"
                    android:textColor="#9AA3B2" />

                <TextView
                    android:id="@+id/ecowitt_widget_filler_1_0"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/ecowitt_widget_value_1_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/ecowitt_widget_unit_1_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:textSize="9sp"
                    android:textColor="#9AA3B2" />

                <TextView
                    android:id="@+id/ecowitt_widget_sub_1_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:textSize="9sp"
                    android:textColor="#9AA3B2"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ecowitt_widget_row_1_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
